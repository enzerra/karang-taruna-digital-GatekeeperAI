# ============================ Server ============================
PORT=4000
# Origin frontend yang diizinkan (pisahkan dengan koma). Kosongkan = izinkan semua.
CORS_ORIGIN=http://localhost:5173

# ========================== Sumber data =========================
# json     -> simpan ke file data/db.json (default, tanpa perlu PostgreSQL)
# postgres -> konek ke PostgreSQL (lihat konfigurasi di bawah)
DB_DRIVER=json

# ===================== PostgreSQL (DB_DRIVER=postgres) ===========
# Karena DB & aplikasi berjalan di device yang sama, host = localhost.
# Cukup isi password sesuai instalasi PostgreSQL Anda.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=passwordku
PGDATABASE=karang_taruna

# Alternatif: satu connection string (kalau diisi, mengabaikan PG* di atas).
# DATABASE_URL=postgresql://postgres:passwordku@localhost:5432/karang_taruna
