# Konfigurasi Backend Node.js
PORT=4000

# Pengaturan Database (Pilih: 'supabase' atau 'json')
DB_DRIVER=supabase

# URL & Kunci Rahasia Supabase (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
# PERINGATAN: Gunakan service_role key untuk SUPABASE_SERVICE_KEY, bukan anon key.
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
